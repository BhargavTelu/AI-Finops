# Copy this file to .env.local and fill in values.
# NEVER commit .env.local - it is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Clerk ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── FastAPI Backend ────────────────────────────────────────────────────────────
# Server-only secret - never sent to the browser. Next.js uses this to proxy
# /api/v1/* requests (rewrites in next.config.mjs) and for server component fetches.
# Local dev: http://localhost:8000
# Production: your Railway service URL, e.g. https://spendops-api.up.railway.app
API_INTERNAL_URL=http://localhost:8000

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PostHog ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Slack ─────────────────────────────────────────────────────────────────────
# Used by the frontend to build the Slack OAuth URL (not a secret; visible in browser URL).
SLACK_CLIENT_ID=
SLACK_REDIRECT_URI=http://localhost:3000/settings/slack/callback

# ── Sentry ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
