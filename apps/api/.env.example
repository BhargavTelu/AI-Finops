# Copy to .env and fill in values.
# NEVER commit .env — it is gitignored.

# ── Environment ───────────────────────────────────────────────────────────────
ENV=local

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Clerk ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Clerk Dashboard → API Keys → "Frontend API URL". Required for JWT verification.
# Example: https://your-instance.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# ── Redis (Upstash in prod, localhost in dev) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_BUCKET_NAME=ai-finops-reports
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Internal AI ───────────────────────────────────────────────────────────────
# Platform's own Anthropic key for recommendations + narratives (M4/V1).
# NOT a customer key — those are stored encrypted in the DB.
ANTHROPIC_API_KEY=sk-ant-...

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key — generate once:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=
